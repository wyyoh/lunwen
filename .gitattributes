* text=auto eol=lf
*.ps1 text eol=crlf
*.csv text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf

# Stage C2.4 manifests hash the generated on-disk bytes.  Preserve those
# byte-for-byte in Git instead of normalizing JSON/CSV line endings.
artifacts/stage_c24/** -text whitespace=cr-at-eol
artifacts/stage_c24_smoke/** -text whitespace=cr-at-eol

# Stage C2.4b manifests likewise bind the exact generated JSON/CSV bytes.
artifacts/stage_c24b/** -text whitespace=cr-at-eol
artifacts/stage_c24b_smoke/** -text whitespace=cr-at-eol
artifacts/stage_c24b_v21/** -text whitespace=cr-at-eol
artifacts/stage_c24c/** -text whitespace=cr-at-eol
artifacts/stage_c24c_smoke/** -text whitespace=cr-at-eol
artifacts/stage_c25/** -text whitespace=cr-at-eol
